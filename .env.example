# Configuración de Servidor
HOST=0.0.0.0
PORT=8085
DEBUG=false

# Persistencia
DB_PATH=data/bookmarks.db

# Credenciales de Twitter / X (Opcional para extractor GraphQL directo)
# Obtenidas desde las cookies del navegador al iniciar sesión en x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Motor de Clasificación con IA
# Proveedores soportados: groq | gemini | heuristic
AI_PROVIDER=heuristic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
